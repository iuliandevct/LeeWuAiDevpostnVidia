# ==============================================================================
# LeeWu AI - Production & Development Environment Variable Template
# ==============================================================================
# Copy this file to .env and configure with your private credentials:
#   cp .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS TO GIT. .env is strictly ignored by .gitignore.
# ==============================================================================

# 1. Nebius Token Factory / NVIDIA Model Gateway
# Static Service Account Key format: [REDACTED_NEBIUS_KEY]
NEBIUS_API_KEY=your_nebius_api_key_here

# Official OpenAI-compatible base URL:
# - https://api.tokenfactory.nebius.com/v1 (Production default)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Configurable NVIDIA Nemotron Model Identifier
# - nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B (Default: fast reasoning)
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# API Request Timeout (seconds)
NEBIUS_TIMEOUT=45

# Bounded Retries & Backoff Settings (Optional)
NEBIUS_MAX_RETRIES=3
NEBIUS_RETRY_DELAY=1.0

# Opt-in Flag for Live Inference Integration Tests (0=disabled, 1=enabled)
RUN_LIVE_NEBIUS_TESTS=0

# 2. Local Python Server & Network Configuration
PORT=8080
HOST=127.0.0.1
DATA_DIR=data

# 3. Security & CORS Origin Configuration (Comma-separated)
ALLOWED_ORIGINS=https://leewuai.ro,https://www.leewuai.ro,https://console.leewuai.ro
ADMIN_API_KEY=your_secret_admin_bearer_token_here
REQUIRE_AUTH_FOR_WRITES=false

# 4. Telegram Autonomous Field Surveyor Daemon (@Leewubot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_authorized_chat_id_here
TELEGRAM_ALLOWED_USERS=your_authorized_telegram_user_or_chat_ids_comma_separated

# 5. Optional Integrations
TAVILY_API_KEY=your_tavily_api_key_here
SUPABASE_URL=https://auth.leewuai.ro
SUPABASE_ANON_KEY=your_supabase_anon_key_here
