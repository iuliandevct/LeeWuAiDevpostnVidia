# 2. SQLite & Local Databases
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
data/*.db
data/tavily_cache.db
data/leewu_mvp.db

# 3. Dynamic Uploads, Evidence & Media Artifacts
data/uploads/*
