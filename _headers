# ==============================================================================
# Cloudflare Pages Edge Security Headers
# Applied automatically by Cloudflare Anycast CDN to all static assets
# ==============================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' https: data: blob: 'unsafe-inline'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# Cache static assets aggressively
/data/media/*
  Cache-Control: public, max-age=604800, immutable

/data/uploads/*
  Cache-Control: public, max-age=86400
