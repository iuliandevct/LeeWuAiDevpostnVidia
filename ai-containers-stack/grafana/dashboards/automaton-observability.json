{
  "uid": "automaton-observability",
  "title": "Conway Automaton Observability",
  "tags": ["automaton", "conway", "supabase", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Heartbeats (6h)",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "select count(*)::bigint as value from public.automaton_activity where event_type = 'heartbeat' and recorded_at >= now() - interval '6 hours';"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last heartbeat age",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "select extract(epoch from (now() - max(recorded_at)))::bigint as value from public.automaton_activity;"
      }],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 120}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current state",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "select status from public.automaton_activity order by recorded_at desc limit 1;"
      }],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors (24h)",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "select count(*)::bigint as value from public.automaton_activity where status in ('error','degraded','offline') and recorded_at >= now() - interval '24 hours';"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heartbeat activity",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 6},
      "targets": [{
        "refId": "A",
        "format": "time_series",
        "rawQuery": true,
        "rawSql": "select $__timeGroupAlias(recorded_at, '1m'), count(*)::double precision as heartbeats from public.automaton_activity where $__timeFilter(recorded_at) and event_type = 'heartbeat' group by 1 order by 1;"
      }],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent activity",
      "datasource": {"type": "postgres", "uid": "supabase-postgres"},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 6},
      "targets": [{
        "refId": "A",
        "format": "table",
        "rawQuery": true,
        "rawSql": "select recorded_at as time, status, event_type, summary from public.automaton_activity order by recorded_at desc limit 20;"
      }],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
  ]
}
