# Copy to ~/.hermes/.env inside WSL and replace every placeholder locally.
# Never commit or send the completed file.
GEMINI_API_KEY=REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_NUMERIC_TELEGRAM_USER_ID

# Cloud inference keeps RAM/CPU use low on the Acer.
HERMES_MODEL=gemini-2.5-flash-lite
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
